{:paths     ["src" "resources"]
 ; Specify repos as fix for potential missing versions in classpath
 :mvn/repos {"central" {:url "https://repo1.maven.org/maven2/"} ; Fix found here: https://github.com/juxt/pack.alpha/issues/7
             "clojars" {:url "https://repo.clojars.org/"}       ; No need to explain here
             "jitpack" {:url "https://jitpack.io"}}             ; Jitpack is to import github repositories
 :deps      {org.clojure/clojure                          {:mvn/version "1.12.5"} ; Parens
             cljfx/cljfx                                  {:mvn/version "1.10.8"} ; GUI shizzle (https://github.com/cljfx/cljfx)
             cljfx/css                                    {:mvn/version "1.1.0"}  ; Pretty GUI shizzle (https://github.com/cljfx/css)
             org.usb4java/usb4java                        {:mvn/version "1.3.0"}  ; Required for USB driver (https://github.com/usb4java/usb4java)
             org.usb4java/usb4java-javax                  {:mvn/version "1.3.0"}  ; Required for USB driver (https://github.com/usb4java/usb4java-javax)
             ; Community-published native libs filling the darwin-aarch64 + win32-aarch64 gap
             ; missing from org.usb4java:libusb4java:1.3.0 (Maven Central never got arm64 Mac /
             ; arm64 Windows classifier from upstream). Packs at the same `org/usb4java/<arch>/`
             ; path the upstream loader expects, so adding this dep alone wires Apple Silicon
             ; + Windows-on-ARM hosts without a libusb4java fork.
             io.github.dsheirer/usb4java-native-libraries {:mvn/version "1.3.1"}
             usbsid/usbsid-usb-driver-library-java        {:mvn/version "1.2"}    ; USBSID-Pico driver (I made that, wow!)
             ; JavaFX native JARs.
             ; cljfx declares only the base (class-only) JARs; without these
             ; platform-classifier JARs the Prism graphics pipeline has no native
             ; DLL/SO/dylib to load, causing "no suitable pipeline found" on any
             ; platform that wasn't the build host.
             ;
             ; $linux is pulled transitively by cljfx (build host = Linux).
             ; $win has no naming collision with $linux/$mac (different file extensions)
             ; so it stays in root :deps for cross-platform fat-jar Linux/Win.
             ;
             ; $mac and $mac-aarch64 are NOT in root :deps because both classifier JARs
             ; pack identically-named .dylib files at JAR root (libprism_es2.dylib etc.).
             ; Merging both into one uber lets only one arch survive → arch-mismatch
             ; UnsatisfiedLinkError on whichever JVM doesn't match the surviving arch.
             ; See aliases :jfx-mac-x64 / :jfx-mac-arm - picked per build host in build.clj.
             org.openjfx/javafx-base$win                  {:mvn/version "22-ea+16"}
             org.openjfx/javafx-graphics$win              {:mvn/version "22-ea+16"}
             org.openjfx/javafx-controls$win              {:mvn/version "22-ea+16"}
             org.openjfx/javafx-media$win                 {:mvn/version "22-ea+16"}}
 :aliases
 {; clj -M:run-m
  :run-m {:main-opts ["-m" "usbsid.core"]
          :jvm-opts  ["--enable-native-access=ALL-UNNAMED"
                      "--sun-misc-unsafe-memory-access=allow"]}
  ; clj -X:run-x
  :run-x {:ns-default usbsid.core
          :exec-fn    -main
          :exec-args  {:name "Clojure"}
          :jvm-opts   ["--enable-native-access=ALL-UNNAMED"
                       "--sun-misc-unsafe-memory-access=allow"]}
  :dev   {:extra-paths ["dev/src" "dev/resources"]
          :extra-deps  {; app related testing tools
                        io.github.cljfx/dev                       {:mvn/version "1.10.6.44"}  ; GUI shizzle for dummies (https://github.com/cljfx/dev)
                        ; deps for development testing with Clojure tools
                        org.clojure/tools.deps                    {:mvn/version "0.30.1611"}, ; Functional API for transitive dependency graph expansion and the creation of classpaths (https://github.com/clojure/tools.deps)
                        org.clojure/tools.namespace               {:mvn/version "1.5.1"},     ; Tools for managing namespaces in Clojure (https://github.com/clojure/tools.namespace)
                        ; deps for development testing with Babashka
                        borkdude/babashka                         {:mvn/version "0.2.6"},     ; Native Clojure interpreter for scripting with fast startup (https://github.com/babashka/babashka)
                        babashka/fs                               {:mvn/version "0.5.33"},    ; File system utilities (https://github.com/babashka/babashka)
                        babashka/babashka.pods                    {:mvn/version "0.2.0"},     ; Expose namespaces with vars to babashka or a JVM (https://github.com/babashka/pods)
                        ; deps for debugging
                        djblue/portal                             {:mvn/version "0.65.0"},    ; A clojure tool to navigate through your data (https://github.com/djblue/portal)
                        com.github.jpmonettas/flow-storm-dbg      {:mvn/version "3.7.5"},     ; Tracing debugger for Clojure and Clojure(Script) (https://github.com/jpmonettas/flow-storm-debugger)
                        com.clojure-goes-fast/clj-async-profiler  {:mvn/version "1.7.0"},     ; Embedded high-precision performance profiler for Clojure (https://github.com/clojure-goes-fast/clj-async-profiler)
                        com.clojure-goes-fast/clj-java-decompiler {:mvn/version "0.3.7"},     ; integrated Clojure-to-Java decompiler for the REPL (https://github.com/clojure-goes-fast/clj-java-decompiler)
                        }
          :jvm-opts    ["--enable-native-access=ALL-UNNAMED"
                        "--sun-misc-unsafe-memory-access=allow"
                        "-Dusbsid-dev-env=True"]}
  :build {:deps       {io.github.clojure/tools.build
                       {:mvn/version "0.10.14"}}
          :jvm-opts   ["--enable-native-access=ALL-UNNAMED"
                       #_"--sun-misc-unsafe-memory-access=allow" ; JDK 22+
                       "-Dcljfx.skip-javafx-initialization=true"]
          :ns-default build}
  :test  {:extra-paths ["test"]
          :extra-deps  {org.clojure/test.check               {:mvn/version "1.1.3"}
                        io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                              :git/sha "dfb30dd"}}}
  ; macOS JavaFX native classifier - exactly one selected by build.clj per host arch.
  ; Keeping them mutually exclusive avoids the libprism_es2.dylib collision in uber.
  :jfx-mac-x64
  {:extra-deps {org.openjfx/javafx-base$mac     {:mvn/version "22-ea+16"}
                org.openjfx/javafx-graphics$mac {:mvn/version "22-ea+16"}
                org.openjfx/javafx-controls$mac {:mvn/version "22-ea+16"}
                org.openjfx/javafx-media$mac    {:mvn/version "22-ea+16"}}}
  :jfx-mac-arm
  {:extra-deps {org.openjfx/javafx-base$mac-aarch64     {:mvn/version "22-ea+16"}
                org.openjfx/javafx-graphics$mac-aarch64 {:mvn/version "22-ea+16"}
                org.openjfx/javafx-controls$mac-aarch64 {:mvn/version "22-ea+16"}
                org.openjfx/javafx-media$mac-aarch64    {:mvn/version "22-ea+16"}}}}}
